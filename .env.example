# EdgeVision Control Hub configuration.
#
# Loading order (last wins):
#   .env  →  .env.local  →  os.environ
# Put per-machine secrets in .env.local (gitignored). Use os.environ for
# CI/Docker overrides.
#
# Required vs optional is documented per section. Unknown EDGEVISION_*,
# FORGE_* keys are logged as warnings (typo guard).

# ─── Forge backend ────────────────────────────────────────────────────────────
# Required when SIMULATION_MODE=false. Use a token (preferred) OR
# username + password — if both are set, the token wins.
FORGE_URL=https://forge.iinia.ai/api/swagger/
FORGE_TOKEN=
FORGE_USERNAME=
FORGE_PASSWORD=

# Optional direct URL to a Forge-hosted .pt artifact. If MODEL_DIR has no .pt,
# the app downloads this and uses it for UI render/inference.
FORGE_MODEL_URL=

# Optional UUID for the documented CVAT/Forge asset endpoint: GET /api/assets/{uuid}.
# Use this when the .pt was uploaded as an asset instead of exposed by URL.
FORGE_MODEL_ASSET_UUID=

# ─── Storage paths ────────────────────────────────────────────────────────────
# Where ML model files live and where captures + audit/telemetry JSONL go.
MODEL_DIR=models
CAPTURE_DIR=captures

# ─── Runtime mode ─────────────────────────────────────────────────────────────
# true  → forces the development/mock provider regardless of host hardware.
# false → autodetects (Jetson/RPi/development) unless HARDWARE_OVERRIDE is set.
SIMULATION_MODE=true

# Optional. Force a specific hardware profile (jetson, raspberry, development).
# Useful for CI on ARM or for developing on a laptop as if it were a Jetson.
# Each profile also drives the UI layout: jetson→multi-camera tile grid,
# raspberry→single-camera fullscreen-friendly mode (collapsed sidebar, F11 toggle),
# development→full desktop layout.
# HARDWARE_OVERRIDE=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Directory for the rotating log file. Defaults to ~/.cache/edgevision/.
# LOG_DIR=/var/log/edgevision

# ─── Operational tuning ───────────────────────────────────────────────────────
# How long to drive each GPIO pin per detection (seconds).
GPIO_PULSE_SECONDS=0.1

# Suppress duplicate fires of the same label across cameras within this window.
GPIO_DEDUPE_SECONDS=1.0

# Inference watchdog: restart the worker if the heartbeat is older than this.
WATCHDOG_TIMEOUT_SECONDS=2.5

# HTTP retries on transient failures (5xx, 408, 425, 429, network).
HTTP_RETRY_ATTEMPTS=3

# ─── Inference outputs ────────────────────────────────────────────────────────
# GPIO output is configured in the Forge tab by dragging labels to GPIO ports.
# These outputs publish the same inference payload used by the UI overlay.
OUTPUT_MQTT_ENABLED=false
OUTPUT_MQTT_HOST=
OUTPUT_MQTT_PORT=1883
OUTPUT_MQTT_TOPIC=edgevision/inference

OUTPUT_HTTP_ENABLED=false
OUTPUT_HTTP_URL=

OUTPUT_WEBSOCKET_ENABLED=false
OUTPUT_WEBSOCKET_URL=

OUTPUT_TCP_ENABLED=false
OUTPUT_TCP_HOST=
OUTPUT_TCP_PORT=9000

OUTPUT_UDP_ENABLED=false
OUTPUT_UDP_HOST=
OUTPUT_UDP_PORT=9001

# Modbus TCP writes detection count to a holding register and active state to a coil.
OUTPUT_MODBUS_ENABLED=false
OUTPUT_MODBUS_HOST=
OUTPUT_MODBUS_PORT=502
OUTPUT_MODBUS_UNIT_ID=1
OUTPUT_MODBUS_COUNT_REGISTER=0
OUTPUT_MODBUS_ACTIVE_COIL=0
